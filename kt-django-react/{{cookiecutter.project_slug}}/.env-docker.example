# Docker deployment environment variables.
# Copy to .env-docker and fill in the values before running docker compose.

# Django
SECRET_KEY=change-me
DEBUG=False
ENVIRONMENT=production
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:80
CSRF_TRUSTED_ORIGINS=http://localhost:80
TIME_ZONE=UTC
LOGGING_LEVEL=ERROR

# Database
## DATABASE_URL is constructed automatically by docker-compose from POSTGRES_* vars.
POSTGRES_USER={{ cookiecutter.package_name }}
POSTGRES_PASSWORD={{ cookiecutter.package_name }}
POSTGRES_DB={{ cookiecutter.package_name }}

{% if cookiecutter.use_celery == "yes" %}# Celery / Redis
CELERY_BROKER_URL=redis://redis:6379/0

{% endif %}# Admin superuser — created automatically on first run by the upgrade command
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me
{% if cookiecutter.use_sentry == "yes" %}
# Sentry
SENTRY_DSN=
{% endif %}