{
    "project__name": "KTech Django Application",
    "project__slug": "{{ cookiecutter.project__name | slugify }}",
    "project__module": "{{ cookiecutter.project__slug | replace('-', '_') }}",
    "project__author": "KTech",
    "__project__pascal_case_name": "{{ cookiecutter.project__slug.split('-') | map('capitalize') | join }}",
    "github_team": "k-tech-italy",
    "__github_base_url": "https://github.com/{{ cookiecutter.github_team }}/{{ cookiecutter.project__slug }}",
    "_copy_without_render": [
        "*.html",
        ".github/actions/python-uv-setup/action.yaml",
        ".github/workflows/docs.yml",
        ".github/workflows/test.yml",
        ".github/workflows/lint.yml"
    ]
}
